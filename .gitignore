# ============================
# Root .gitignore
# Sistem Pencatatan Asset
# ============================

# ============================
# General / Shared
# ============================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment variables
.env
.env.*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Misc
*.pem

# ============================
# Frontend (Next.js)
# ============================

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Testing
frontend/coverage/

# Vercel
frontend/.vercel

# TypeScript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ============================
# Backend (Express / Node.js)
# ============================

# Uploads (gambar aset yang di-upload user)
backend/public/images/*
!backend/public/images/.gitkeep
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Build / dist
backend/dist/
backend/build/

# Logs
backend/logs/
backend/*.log

# Scratch / Temporary files
backend/scratch/
*.tmp
*.temp
*.bak
*.backup

# ============================
# AI / Tools Config
# ============================
.gemini/

# ============================
# Additional Logs (root level)
# ============================
*.log
